--- /dev/null
+++ b/src/channels/telegram/desktop-session-bridge.ts
@@ -0,0 +1,55 @@
+import { isIncognitoSession, type SessionState } from "../../session/index.js";
+
+export const DESKTOP_BRIDGE_MARKER = "desktopTelegramBridge";
+
+export function isDesktopSession(session: SessionState): boolean {
+  // Read the legacy marker so existing linked sessions survive the naming migration.
+  const marked = session.metadata?.[DESKTOP_BRIDGE_MARKER] === true ||
+    session.metadata?.macTelegramBridge === true;
+  return marked && !isIncognitoSession(session);
+}
+
+export function desktopReadCommand(text: string): "status" | "result" | null {
+  const value = text.trim().toLowerCase().replace(/[?!.]+$/u, "").trim();
+  if (["wie weit bist du", "wie weit", "status", "fortschritt", "how far are you", "how is it going", "how far along are you", "what is your progress"].includes(value)) return "status";
+  if (["zeige mir das ergebnis", "zeige mir das ergebnis deiner analyse", "zeige mir den plan", "ergebnis", "show me the result", "show me the plan", "show me the result of your analysis", "show me your analysis"].includes(value)) return "result";
+  return null;
+}
+
+export function desktopSessionStatus(session: SessionState, busy: boolean): string {
+  const lines = [
+    `Desktop session: ${session.id}`,
+    `Project: ${session.workingDir}`,
+    `Status: ${busy ? "running" : session.status}`,
+    `Steps: ${session.stepCount}`,
+  ];
+  if (session.plan?.items.length) {
+    const done = session.plan.items.filter(item => item.status === "done").length;
+    lines.push(`Plan: ${done}/${session.plan.items.length} completed`);
+    const current = session.plan.items.find(item => item.status === "in_progress");
+    if (current) lines.push(`Current step: ${current.step}`);
+  }
+  if (session.latestResult) lines.push(`Last result: ${session.latestResult.summary.slice(0, 700)}`);
+  if (session.lastError) lines.push(`Notice: ${session.lastError.slice(0, 500)}`);
+  return lines.join("\n");
+}
+
+export function desktopResult(session: SessionState, busy: boolean): string {
+  // Show only an answer to the current request, never a previous turn's plan.
+  const recent = [...session.turns].reverse();
+  const request = recent.findIndex(turn => turn.kind === "user" && !turn.steered);
+  const reply = recent.slice(0, request < 0 ? recent.length : request).find(turn =>
+    turn.kind === "assistant_reply" && !turn.progressNote && !turn.stopped
+  );
+  if (reply?.kind === "assistant_reply") return reply.text;
+  const latestRequestAt = request < 0 ? 0 : recent[request]!.at;
+  const plan = session.plan && session.plan.updatedAt >= latestRequestAt
+    ? session.plan.items.map(item =>
+        `${item.status === "done" ? "✓" : item.status === "in_progress" ? "→" : "•"} ${item.step}`
+      ).join("\n")
+    : undefined;
+  return [
+    busy ? "The task is still running. A final answer is not available yet." : "No final answer is available for the latest request.",
+    plan ? `Work plan so far:\n${plan}` : "",
+  ].filter(Boolean).join("\n\n");
+}
