+import { describe, expect, it, vi } from "vitest";
+import { DesktopRequestQueue } from "./desktop-request-queue.js";
+
+describe("desktop request queue", () => {
+  it("runs requests in FIFO order and keeps accepting work while one runs", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const order: string[] = [];
+    let release!: () => void;
+    const onError = vi.fn();
+    queue.enqueue(async () => {
+      order.push("first start");
+      await new Promise<void>(resolve => { release = resolve; });
+      order.push("first end");
+    }, onError);
+    queue.enqueue(async () => { order.push("second"); }, onError);
+    await vi.waitFor(() => expect(queue.active).toBe(true));
+    expect(queue.size).toBe(2);
+    release();
+    await queue.settled();
+    expect(order).toEqual(["first start", "first end", "second"]);
+    expect(queue.size).toBe(0);
+    expect(onError).not.toHaveBeenCalled();
+  });
+
+  it("cancels the active request and prevents queued requests from starting", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const skipped = vi.fn();
+    const onError = vi.fn();
+    queue.enqueue(signal => new Promise<void>(resolve => signal.addEventListener("abort", () => resolve(), { once: true })), onError);
+    queue.enqueue(skipped, onError);
+    await vi.waitFor(() => expect(queue.active).toBe(true));
+    expect(queue.cancelAll()).toBe(2);
+    await queue.settled();
+    expect(skipped).not.toHaveBeenCalled();
+    expect(queue.size).toBe(0);
+  });
+
+  it("continues draining after a failed request", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const onError = vi.fn();
+    const next = vi.fn(async () => {});
+    queue.enqueue(async () => { throw new Error("failed"); }, onError);
+    queue.enqueue(next, onError);
+    await queue.settled();
+    expect(onError).toHaveBeenCalledOnce();
+    expect(next).toHaveBeenCalledOnce();
+  });
+});
