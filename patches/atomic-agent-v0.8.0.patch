+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync, symlinkSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { captureDesktopGitReview } from "./desktop-review-git.js";
+
+let dir: string;
+const git = (...args: string[]) => execFileSync("git", args, { cwd: dir, encoding: "utf8" });
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "atomic-review-"));
+  git("init", "-q");
+  git("config", "core.autocrlf", "false");
+  writeFileSync(join(dir, "tracked.txt"), "before\n");
+  git("add", "tracked.txt");
+  git("-c", "user.name=Test", "-c", "user.email=test@example.invalid", "commit", "-qm", "fixture");
+});
+afterEach(() => rmSync(dir, { recursive: true, force: true }));
+
+describe("Git review snapshot", () => {
+  it("reads staged, unstaged and untracked state without changing the index", async () => {
+    writeFileSync(join(dir, "tracked.txt"), "staged\n");
+    git("add", "tracked.txt");
+    writeFileSync(join(dir, "tracked.txt"), "working\n");
+    writeFileSync(join(dir, "new file.txt"), "new\n");
+    const before = git("status", "--porcelain=v1");
+    const snapshot = await captureDesktopGitReview(dir);
+    expect(snapshot.summary).toContain("Staged:");
+    expect(snapshot.summary).toContain("Unstaged:");
+    expect(snapshot.summary).toContain('"new file.txt"');
+    expect(snapshot.diff).toContain("+staged");
+    expect(snapshot.diff).toContain("+working");
+    expect(git("status", "--porcelain=v1")).toBe(before);
+    expect((await captureDesktopGitReview(dir)).fingerprint).toBe(snapshot.fingerprint);
+  });
+
+  it("detects same-size untracked and tracked edits even when status is unchanged", async () => {
+    writeFileSync(join(dir, "new.txt"), "one");
+    const first = await captureDesktopGitReview(dir);
+    writeFileSync(join(dir, "new.txt"), "two");
+    const second = await captureDesktopGitReview(dir);
+    expect(second.fingerprint).not.toBe(first.fingerprint);
+    writeFileSync(join(dir, "tracked.txt"), "AFTER!\n");
+    expect((await captureDesktopGitReview(dir)).fingerprint).not.toBe(second.fingerprint);
+  });
+
+  it("supports an unborn repository and refuses a directory without Git", async () => {
+    git("checkout", "--orphan", "unborn");
+    git("rm", "--cached", "tracked.txt");
+    expect((await captureDesktopGitReview(dir)).summary).toContain("Untracked");
+    rmSync(join(dir, ".git"), { recursive: true, force: true });
+    await expect(captureDesktopGitReview(dir)).rejects.toThrow();
+  });
+
+  it.skipIf(process.platform === "win32")("refuses symlinks rather than following them outside the project", async () => {
+    symlinkSync(join(dir, "tracked.txt"), join(dir, "link.txt"));
+    await expect(captureDesktopGitReview(dir)).rejects.toThrow("symlinks");
+  });
+});
diff --git a/src/channels/telegram/desktop-review-git.ts b/src/channels/telegram/desktop-review-git.ts
new file mode 100644
index 0000000..d5a530a
--- /dev/null
+++ b/src/channels/telegram/desktop-review-git.ts
@@ -0,0 +1,75 @@
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { createReadStream } from "node:fs";
+import { lstat, realpath } from "node:fs/promises";
+import { resolve, relative, isAbsolute, sep } from "node:path";
+import { promisify } from "node:util";
+
+const execute = promisify(execFile);
+const MAX_BYTES = 2 * 1024 * 1024;
+
+/** Read only: no shell, optional index writes, external diff drivers or fsmonitor. */
+async function git(cwd: string, args: string[]): Promise<string> {
+  const result = await execute("git", ["--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false", ...args], {
+    cwd, timeout: 10_000, maxBuffer: MAX_BYTES, windowsHide: true,
+    env: { ...process.env, GIT_TERMINAL_PROMPT: "0", GIT_PAGER: "cat" },
+  });
+  return result.stdout;
+}
+
+export interface DesktopGitReview {
+  fingerprint: string;
+  summary: string;
+  diff: string;
+}
+
+/** Fail closed on oversized/unstable snapshots; never silently approve a partial tree. */
+export async function captureDesktopGitReview(workingDir: string): Promise<DesktopGitReview> {
+  const root = (await git(workingDir, ["rev-parse", "--show-toplevel"])).trim();
+  if (!root) throw new Error("No Git working tree.");
+  const status = await git(root, ["status", "--porcelain=v1", "-z", "--untracked-files=all"]);
+  const tracked = await git(root, ["ls-files", "-z"]);
+  const untracked = await git(root, ["ls-files", "--others", "--exclude-standard", "-z"]);
+  const paths = [...new Set((tracked + untracked).split("\0").filter(Boolean))];
+  if (paths.length > 10_000) throw new Error("The repository is too large for a bounded review.");
+  const hash = createHash("sha256").update(status);
+  let total = 0;
+  // Hash actual worktree bytes, including untracked files. A second snapshot at
+  // execution catches edits after the button was shown, even same-size edits.
+  for (const file of paths.sort()) {
+    hash.update(JSON.stringify(file));
+    const path = resolve(root, file);
+    const rel = relative(root, path);
+    if (isAbsolute(rel) || rel === ".." || rel.startsWith(`..${sep}`)) throw new Error("Unsafe Git path.");
+    const stat = await lstat(path).catch(error => {
+      if (error.code === "ENOENT") return null;
+      throw error;
+    });
+    if (!stat) { hash.update("missing"); continue; }
+    // Symlinks and submodules may point outside the reviewed project. Keep the
+    // implementation conservative rather than reading or claiming coverage.
+    if (!stat.isFile() || (await realpath(path)) !== path) throw new Error("Review does not support symlinks or submodules.");
+    total += stat.size;
+    if (total > 32 * MAX_BYTES) throw new Error("The repository exceeds the review byte limit.");
+    let bytes = 0;
+    for await (const chunk of createReadStream(path)) {
+      bytes += chunk.length;
+      if (bytes > stat.size || bytes + total - stat.size > 32 * MAX_BYTES) throw new Error("The repository changed during review.");
+      hash.update(chunk);
+    }
+    if (bytes !== stat.size) throw new Error("The repository changed during review.");
+  }
+  const head = await git(root, ["rev-parse", "--verify", "HEAD"]).catch(() => "unborn");
+  const baseArgs = ["--no-ext-diff", "--no-textconv", "--binary"];
+  const staged = await git(root, ["diff", "--cached", ...baseArgs]);
+  const unstaged = await git(root, ["diff", ...baseArgs]);
+  const stats = await git(root, ["diff", "--stat", "--no-ext-diff", "--no-textconv"]);
+  const stagedStats = await git(root, ["diff", "--cached", "--stat", "--no-ext-diff", "--no-textconv"]);
+  if (status !== await git(root, ["status", "--porcelain=v1", "-z", "--untracked-files=all"])) throw new Error("The repository changed during review.");
+  hash.update(root).update(head).update(staged).update(unstaged);
+  return {
+    fingerprint: hash.digest("hex"),
+    summary: [stagedStats.trim() ? `Staged:\n${stagedStats.trim()}` : "", stats.trim() ? `Unstaged:\n${stats.trim()}` : "", untracked ? `Untracked files (contents are not included in the diff):\n${untracked.split("\0").filter(Boolean).map(path => JSON.stringify(path)).join("\n")}` : ""].filter(Boolean).join("\n\n") || "No Git changes.",
+    diff: [staged ? `Staged diff:\n${staged}` : "", unstaged ? `Unstaged diff:\n${unstaged}` : ""].filter(Boolean).join("\n\n") || "No tracked-file diff.",
+  };
+}
