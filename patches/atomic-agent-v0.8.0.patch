+
+async function queueDesktopRequest(text: string, ref: ChatRef, ctx: InboundContext, session: SessionState, beforeRun?: (fresh: SessionState) => Promise<void>): Promise<boolean> {
+  if (!ctx.runtime.turnController.isBusy(session.id) &&
+      ["running", "awaiting_approval", "awaiting_llm"].includes(session.status)) {
+    await sendText(ctx, ref.target, "Continue this active or interrupted session in this terminal process before queuing a follow-up.");
+    return false;
+  }
+  const queues = ctx.desktopQueues ??= new Map<string, DesktopRequestQueue>();
+  let queue = queues.get(ref.key);
+  if (!queue || queue.sessionId !== session.id) {
+    if (queue?.size) {
+      await sendText(ctx, ref.target, "The previous session still has queued requests. Use /cancel first.");
+      return false;
+    }
+    queue = new DesktopRequestQueue(session.id);
+    queues.set(ref.key, queue);
+  }
+  const selectedQueue = queue;
+  const accepted = queue.enqueue(async signal => {
+    // Capture the session at acceptance, so switching chats never redirects a queued request.
+    if (signal.aborted) return;
+    const current = ctx.runtime.sessionStore.load(session.id);
+    if (!current || !isDesktopSession(current)) {
+      throw new Error("The linked desktop session is no longer available.");
+    }
+    await dispatchToRuntime(text, ref, ctx, null, current, signal, beforeRun);
+  }, error => {
+    ctx.logger.warn("desktop Telegram follow-up failed", { error: scrubErrorMessage(error instanceof Error ? error.message : String(error)) });
+    void sendText(ctx, ref.target, "The queued desktop request failed. Check /status before retrying.")
+      .catch(() => ctx.logger.warn("Could not deliver the queued request failure notice."));
+  });
+  if (!accepted) {
+    await sendText(ctx, ref.target, "The desktop queue is full (20 outstanding requests). Wait for work to finish or use /cancel.");
+    return false;
+  }
+  await sendText(ctx, ref.target,
+    `Request queued for desktop session ${session.id}. Outstanding Telegram requests: ${selectedQueue.size}. It will run after earlier work. Use /status to check progress.`);
+  return true;
+}
+
+async function connectDesktopSession(id: string | undefined, ref: ChatRef, ctx: InboundContext): Promise<void> {
+  if (!ref.isPrivate) {
+    await sendText(ctx, ref.target, "Desktop sessions are available only in the paired owner’s private chat.");
+    return;
+  }
+  if (ctx.inflight.has(ref.key) || (ctx.desktopQueues?.get(ref.key)?.size ?? 0) > 0) {
+    await sendText(ctx, ref.target, "A Telegram request is still running or queued. Wait for it to finish or use /cancel.");
+    return;
+  }
+  if (id === "off") {
+    const current = ctx.sessionPointer.get(ref.key).current;
+    if (current) ctx.releaseApprovalSession?.(current);
+    ctx.sessionPointer.rotate(ref.key);
+    await sendText(ctx, ref.target, "Desktop session disconnected. Your next message starts a separate Telegram conversation.");
+    return;
+  }
+  const sessions = (ctx.runtime.sessionStore.listRecent?.(100) ?? []).filter(isDesktopSession);
+  const active = sessions.filter(session => ctx.runtime.turnController.isBusy(session.id));
+  const session = id ? ctx.runtime.sessionStore.load(id) : active.length === 1 ? active[0] : active.length > 1 ? null : sessions[0];
+  if (!session || !isDesktopSession(session)) {
+    await sendText(ctx, ref.target, [
+      "No desktop session was selected. Start a task in the updated Atomic terminal interface, then send /desktop. If several tasks are running, choose one with /desktop <session-id>.",
+      ...sessions.slice(0, 10).map(item => `${item.id} — ${item.workingDir}${ctx.runtime.turnController.isBusy(item.id) ? " (running)" : ""}`),
