+import { describe, expect, it, vi } from "vitest";
+import { DesktopRequestQueue } from "./desktop-request-queue.js";
+
+describe("desktop request queue", () => {
+  it("runs requests in FIFO order and keeps accepting work while one runs", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const order: string[] = [];
+    let release!: () => void;
+    const onError = vi.fn();
+    queue.enqueue(async () => {
+      order.push("first start");
+      await new Promise<void>(resolve => { release = resolve; });
+      order.push("first end");
+    }, onError);
+    queue.enqueue(async () => { order.push("second"); }, onError);
+    await vi.waitFor(() => expect(queue.active).toBe(true));
+    expect(queue.size).toBe(2);
+    release();
+    await queue.settled();
+    expect(order).toEqual(["first start", "first end", "second"]);
+    expect(queue.size).toBe(0);
+    expect(onError).not.toHaveBeenCalled();
+  });
+
+  it("cancels the active request and prevents queued requests from starting", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const skipped = vi.fn();
+    const onError = vi.fn();
+    queue.enqueue(signal => new Promise<void>(resolve => signal.addEventListener("abort", () => resolve(), { once: true })), onError);
+    queue.enqueue(skipped, onError);
+    await vi.waitFor(() => expect(queue.active).toBe(true));
+    expect(queue.cancelAll()).toBe(2);
+    await queue.settled();
+    expect(skipped).not.toHaveBeenCalled();
+    expect(queue.size).toBe(0);
+  });
+
+  it("continues draining after a failed request", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const onError = vi.fn();
+    const next = vi.fn(async () => {});
+    queue.enqueue(async () => { throw new Error("failed"); }, onError);
+    queue.enqueue(next, onError);
+    await queue.settled();
+    expect(onError).toHaveBeenCalledOnce();
+    expect(next).toHaveBeenCalledOnce();
+  });
+  it("drains even if the error reporter throws", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    const next = vi.fn(async () => {});
+    queue.enqueue(async () => { throw new Error("work failed"); }, () => { throw new Error("report failed"); });
+    queue.enqueue(next, vi.fn());
+    await queue.settled();
+    expect(next).toHaveBeenCalledOnce();
+    expect(queue.size).toBe(0);
+  });
+
+  it("bounds outstanding requests and accepts new work after cancellation drains", async () => {
+    const queue = new DesktopRequestQueue("desktop");
+    for (let i = 0; i < 20; i++) expect(queue.enqueue(async () => {}, vi.fn())).toBe(true);
+    expect(queue.enqueue(async () => {}, vi.fn())).toBe(false);
+    queue.cancelAll();
+    await queue.settled();
+    expect(queue.enqueue(async () => {}, vi.fn())).toBe(true);
+    await queue.settled();
+  });
+
+});
diff --git a/src/channels/telegram/desktop-request-queue.ts b/src/channels/telegram/desktop-request-queue.ts
new file mode 100644
index 0000000..a3c2ea0
--- /dev/null
+++ b/src/channels/telegram/desktop-request-queue.ts
@@ -0,0 +1,40 @@
+/** Serial remote requests for one linked desktop session. Runtime FIFO owns actual execution. */
+export class DesktopRequestQueue {
+  private tail: Promise<void> = Promise.resolve();
+  private readonly controllers = new Set<AbortController>();
+  active = false;
+
+  constructor(readonly sessionId: string) {}
+
+  get size(): number { return this.controllers.size; }
+
+  enqueue(run: (signal: AbortSignal) => Promise<void>, onError: (error: unknown) => void): boolean {
+    if (this.size >= 20) return false;
+    const controller = new AbortController();
+    this.controllers.add(controller);
+    const next = this.tail.then(async () => {
+      if (controller.signal.aborted) return;
+      this.active = true;
+      try {
+        await run(controller.signal);
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          // Reporting must never poison the queue or prevent subsequent work.
+          try { onError(error); } catch { /* Keep draining. */ }
+        }
+      } finally {
+        this.active = false;
+      }
+    });
+    this.tail = next.finally(() => { this.controllers.delete(controller); });
+    return true;
+  }
+
+  cancelAll(): number {
+    const count = this.controllers.size;
+    for (const controller of this.controllers) controller.abort();
+    return count;
+  }
+
+  settled(): Promise<void> { return this.tail; }
+}
