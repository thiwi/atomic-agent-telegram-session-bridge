+import { describe, expect, it } from "vitest";
+import { createEmptySessionState } from "../../session/index.js";
+import { isDesktopSession, desktopReadCommand, desktopResult, desktopSessionStatus } from "./desktop-session-bridge.js";
+
+function session() {
+  return createEmptySessionState({
+    id: "desktop-example",
+    workingDir: "/workspace/example",
+    metadata: { desktopTelegramBridge: true },
+  });
+}
+
+describe("desktop session reading", () => {
+  it("recognizes English progress and analysis requests without inference", () => {
+    expect(desktopReadCommand("How far along are you?")).toBe("status");
+    expect(desktopReadCommand("Show me the result of your analysis.")).toBe("result");
+    expect(desktopReadCommand("Implement the plan")).toBeNull();
+    expect(desktopReadCommand("Wie weit bist du?")).toBe("status");
+  });
+
+  it("returns English status and notices", () => {
+    const value = session();
+    value.plan = { items: [{ step: "Review the modules", status: "in_progress" }], updatedAt: 2 };
+    expect(desktopSessionStatus(value, true)).toContain("Status: running");
+    expect(desktopSessionStatus(value, true)).toContain("Current step: Review the modules");
+    expect(desktopResult(value, true)).toContain("The task is still running");
+    expect(desktopResult(value, false)).toContain("No final answer");
+  });
+
+  it("does not show an older plan as the result of a new request", () => {
+    const value = session();
+    value.turns = [{ kind: "user", text: "New analysis", at: 100 }];
+    value.plan = { items: [{ step: "Old plan", status: "done" }], updatedAt: 1 };
+    expect(desktopResult(value, true)).not.toContain("Old plan");
+    value.plan.updatedAt = 101;
+    expect(desktopResult(value, true)).toContain("Old plan");
+  });
+
+  it("returns the final answer verbatim and ignores progress and stopped replies", () => {
+    const value = session();
+    value.turns = [
+      { kind: "user", text: "Analyse", at: 1 },
+      { kind: "assistant_reply", text: "Working...", progressNote: true, at: 2 },
+      { kind: "assistant_reply", text: "Stopped", stopped: true, at: 3 },
+    ];
+    expect(desktopResult(value, false)).not.toContain("Stopped");
+    value.turns.push({ kind: "assistant_reply", text: "## Analysis\nOriginal details.", at: 4 });
+    expect(desktopResult(value, false)).toBe("## Analysis\nOriginal details.");
+  });
+
+  it("accepts the legacy session marker after migration", () => {
+    const value = session();
+    expect(isDesktopSession({ ...value, metadata: { macTelegramBridge: true } })).toBe(true);
+  });
+
+  it("excludes incognito sessions and sessions without desktop provenance", () => {
+    const value = session();
+    expect(isDesktopSession(value)).toBe(true);
+    expect(isDesktopSession({ ...value, metadata: {} })).toBe(false);
+    expect(isDesktopSession({ ...value, incognito: { since: 1, owner: "fixture" } })).toBe(false);
+  });
+});
