@@ -0,0 +1,126 @@
+import { describe, expect, it, vi } from "vitest";
+import { createEmptySessionState } from "../../session/index.js";
+import { DesktopReviewBridge, desktopReviewEvidence, type DesktopReviewDeps } from "./desktop-review.js";
+
+function fixture() {
+  const session = createEmptySessionState({ id: "desktop", workingDir: "/work/project", metadata: { desktopTelegramBridge: true } });
+  session.turns = [{ kind: "user", text: "Prepare a plan", at: 1 }, { kind: "assistant_reply", text: "Extract a helper and test it.", at: 2 }];
+  const sent: Array<{ text: string; opts?: Record<string, unknown> }> = [];
+  const api = {
+    sendMessage: vi.fn(async (_chat: number, text: string, opts?: Record<string, unknown>) => { sent.push({ text, opts }); return { message_id: sent.length }; }),
+    editMessageText: vi.fn(async () => {}), answerCallbackQuery: vi.fn(async () => {}),
+  };
+  const captureGit = vi.fn(async () => ({ fingerprint: "tree1", summary: "1 file changed", diff: "+helper()" }));
+  const enqueue = vi.fn<DesktopReviewDeps["enqueue"]>(async () => true);
+  const deps: DesktopReviewDeps = { api, ownerUserId: 42, loadSession: () => session, currentSession: () => session.id, isBusy: () => false, hasQueued: () => false, enqueue, captureGit, now: () => 100 };
+  const bridge = new DesktopReviewBridge(deps);
+  function click(action = "a") {
+    const message = [...sent.map((item, index) => ({ ...item, index }))].reverse().find(item => item.opts?.reply_markup !== undefined)!;
+    const keyboard = message.opts!.reply_markup as { inline_keyboard: Array<Array<{ callback_data: string }>> };
+    const data = keyboard.inline_keyboard[0]![action === "a" ? 0 : 1]!.callback_data;
+    return { id: "callback", from: { id: 42 }, message: { chat: { id: 42 }, message_id: message.index + 1 }, data };
+  }
+  return { session, sent, api, captureGit, enqueue, deps, bridge, click };
+}
+
+describe("desktop review", () => {
+  it("shows a read-only report and only enqueues the exact plan after approval", async () => {
+    const f = fixture();
+    await f.bridge.show(f.session, 42);
+    expect(f.enqueue).not.toHaveBeenCalled();
+    expect(f.sent[0]?.text).toContain("Extract a helper and test it.");
+    expect(f.sent[0]?.text).toContain("1 file changed");
+    expect(f.sent[0]?.text).toContain("No retained test/build/lint evidence");
+    const update = f.click();
+    expect(Buffer.byteLength(update.data)).toBeLessThanOrEqual(64);
+    await Promise.all([f.bridge.handleCallback(update), f.bridge.handleCallback(update)]);
+    expect(f.enqueue).toHaveBeenCalledOnce();
+    expect(f.enqueue.mock.calls[0]?.[2]).toContain("<approved-plan>\nExtract a helper and test it.");
+    const guard = f.enqueue.mock.calls[0]![3];
+    await expect(guard(f.session)).resolves.toBeUndefined();
+    f.captureGit.mockResolvedValue({ fingerprint: "tree2", summary: "changed", diff: "" });
+    await expect(guard(f.session)).rejects.toThrow("stale");
+  });
+
+  it("rejects a plan without running or reverting anything", async () => {
+    const f = fixture();
+    await f.bridge.show(f.session, 42);
+    await f.bridge.handleCallback(f.click("r"));
+    expect(f.enqueue).not.toHaveBeenCalled();
+    expect(f.sent.at(-1)?.text).toContain("Existing edits are kept");
+  });
+
+  it.each(["owner", "chat", "message", "data"])("ignores forged %s callbacks without consuming the valid review", async kind => {
+    const f = fixture();
+    await f.bridge.show(f.session, 42);
+    const update = f.click();
+    const forged = structuredClone(update);
+    if (kind === "owner") forged.from.id = 99;
+    if (kind === "chat") forged.message.chat.id = 99;
+    if (kind === "message") forged.message.message_id += 1;
+    if (kind === "data") forged.data = forged.data.replace(/:a$/, ":invalid");
+    await f.bridge.handleCallback(forged);
+    expect(f.enqueue).not.toHaveBeenCalled();
+    await f.bridge.handleCallback(update);
+    expect(f.enqueue).toHaveBeenCalledOnce();
+  });
+
+  it.each(["session", "tree", "expiry", "busy", "queued", "disconnect", "closed"])("refuses approval after %s changes", async kind => {
+    const f = fixture();
+    await f.bridge.show(f.session, 42);
+    const update = f.click();
+    if (kind === "session") f.session.turns.push({ kind: "user", text: "New task", at: 3 });
+    if (kind === "tree") f.captureGit.mockResolvedValue({ fingerprint: "tree2", summary: "changed", diff: "" });
+    if (kind === "expiry") f.deps.now = () => 2_000_000;
+    if (kind === "busy") f.deps.isBusy = () => true;
+    if (kind === "queued") f.deps.hasQueued = () => true;
+    if (kind === "disconnect") f.deps.currentSession = () => null;
+    if (kind === "closed") f.bridge.close();
+    await f.bridge.handleCallback(update);
+    expect(f.enqueue).not.toHaveBeenCalled();
+  });
+
+  it("expires older buttons when a new review is created", async () => {
+    const f = fixture();
+    await f.bridge.show(f.session, 42);
+    const old = f.click();
+    await f.bridge.show(f.session, 42, true);
+    expect(f.sent.some(item => item.text.includes("+helper()"))).toBe(true);
+    await f.bridge.handleCallback(old);
+    expect(f.enqueue).not.toHaveBeenCalled();
+    await f.bridge.handleCallback(f.click());
+    expect(f.enqueue).toHaveBeenCalledOnce();
+  });
+
+  it("fails closed when the report cannot be delivered or captured", async () => {
+    const f = fixture();
+    f.captureGit.mockRejectedValueOnce(new Error("git failed"));
+    await f.bridge.show(f.session, 42);
+    expect(f.sent.some(item => item.opts?.reply_markup)).toBe(false);
+    f.api.sendMessage.mockRejectedValue(new Error("offline"));
+    await f.bridge.show(f.session, 42);
+    expect(f.enqueue).not.toHaveBeenCalled();
+  });
+
+  it("does not approve a truncated plan or an answer from a previous request", async () => {
+    const f = fixture();
+    f.session.turns.push({ kind: "user", text: "new request", at: 3 });
+    await f.bridge.show(f.session, 42);
+    expect(f.sent.some(item => item.opts?.reply_markup)).toBe(false);
+    f.session.turns.push({ kind: "assistant_reply", text: "a".repeat(33_000), at: 4 });
+    await f.bridge.show(f.session, 42);
+    expect(f.sent.some(item => item.opts?.reply_markup)).toBe(false);
+  });
+
+  it("reports actual retained checks without labelling tool success as passing tests", () => {
+    const f = fixture();
+    f.session.turns.splice(1, 0,
+      { kind: "assistant_tool_call", tool: "os.shell.run", args: { command: "npm test" }, at: 2 },
