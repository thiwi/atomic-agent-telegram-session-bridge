+    enqueue: (session, chatId, prompt, beforeRun) => queueDesktopRequest(prompt, { key: telegramChatKey(chatId), target: { chatId }, isPrivate: true, chatType: "private", label: "Desktop" }, ctx, session, beforeRun),
