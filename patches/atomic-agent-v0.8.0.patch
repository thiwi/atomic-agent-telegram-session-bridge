+    return;
+  }
+  const previous = ctx.sessionPointer.get(ref.key).current;
+  if (previous && previous !== session.id) ctx.releaseApprovalSession?.(previous);
+  ctx.sessionPointer.setCurrent(ref.key, session.id, "Desktop");
+  await sendText(ctx, ref.target, `Desktop session connected: ${session.id}
+Project: ${session.workingDir}
