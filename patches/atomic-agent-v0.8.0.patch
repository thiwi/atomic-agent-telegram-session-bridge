index 0000000..dedd75d
--- /dev/null
+++ b/src/channels/telegram/desktop-request-queue.ts
@@ -0,0 +1,35 @@
+/** Serial remote requests for one linked desktop session. Runtime FIFO owns actual execution. */
+export class DesktopRequestQueue {
+  private tail: Promise<void> = Promise.resolve();
+  private readonly controllers = new Set<AbortController>();
+  active = false;
+
+  constructor(readonly sessionId: string) {}
+
+  get size(): number { return this.controllers.size; }
+
+  enqueue(run: (signal: AbortSignal) => Promise<void>, onError: (error: unknown) => void): void {
+    const controller = new AbortController();
+    this.controllers.add(controller);
+    const next = this.tail.then(async () => {
+      if (controller.signal.aborted) return;
+      this.active = true;
+      try {
+        await run(controller.signal);
+      } catch (error) {
+        if (!controller.signal.aborted) onError(error);
+      } finally {
+        this.active = false;
+      }
+    });
+    this.tail = next.finally(() => { this.controllers.delete(controller); });
+  }
+
+  cancelAll(): number {
+    const count = this.controllers.size;
+    for (const controller of this.controllers) controller.abort();
+    return count;
+  }
+
+  settled(): Promise<void> { return this.tail; }
+}
