diff --git a/src/channels/telegram/desktop-review.ts b/src/channels/telegram/desktop-review.ts
new file mode 100644
index 0000000..3e054ac
--- /dev/null
+++ b/src/channels/telegram/desktop-review.ts
@@ -0,0 +1,147 @@
+import { createHash, randomBytes } from "node:crypto";
+import type { SessionState } from "../../session/index.js";
+import { knownSecretsFromEnv, maskSecrets } from "../../error-reporting/secret-detector.js";
+import type { InboundCallbackUpdate } from "./approval-bridge.js";
+import { isDesktopSession } from "./desktop-session-bridge.js";
+import { captureDesktopGitReview, type DesktopGitReview } from "./desktop-review-git.js";
+import { sendOutbound, type TelegramApi } from "./outbound-sender.js";
+
+const TTL_MS = 30 * 60 * 1000;
+const MAX_REPORT = 32_000;
+const safe = (text: string): string => maskSecrets(text, knownSecretsFromEnv(process.env));
+
+export function desktopReviewRevision(session: SessionState): string {
+  return createHash("sha256").update(JSON.stringify({ id: session.id, cwd: session.workingDir, turns: session.turns, plan: session.plan, status: session.status, stepCount: session.stepCount })).digest("hex");
+}
+
+export function desktopReviewPlan(session: SessionState): string | null {
+  const recent = [...session.turns].reverse();
+  const request = recent.findIndex(turn => turn.kind === "user" && !turn.steered);
+  const reply = recent.slice(0, request < 0 ? recent.length : request).find(turn => turn.kind === "assistant_reply" && !turn.progressNote && !turn.stopped && !turn.toolsRan);
+  return reply?.kind === "assistant_reply" && reply.text.trim() ? reply.text : null;
+}
+
+/** Evidence from retained tool results, never an inferred claim that tests passed. */
+export function desktopReviewEvidence(session: SessionState): string {
+  let request = -1;
+  session.turns.forEach((turn, index) => { if (turn.kind === "user" && !turn.steered) request = index; });
+  const pending = new Map<string, string[]>();
+  const evidence: string[] = [];
+  for (const turn of session.turns.slice(request < 0 ? 0 : request + 1)) {
+    if (turn.kind === "assistant_tool_call") {
+      const command = typeof turn.args.command === "string" ? turn.args.command : typeof turn.args.cmd === "string" ? turn.args.cmd : "";
+      const verification = /\b(?:(?:npm|pnpm|yarn)\s+(?:test|run\s+(?:test[^\s]*|lint|typecheck[^\s]*|build))|(?:npx\s+)?vitest|node\s+--test|pytest|cargo\s+test|go\s+test|swift\s+test|xcodebuild\b[^\n]*\btest\b)/u.test(command);
+      const list = pending.get(turn.tool) ?? [];
+      list.push(turn.tool.startsWith("os.shell.") && verification ? command : "");
+      pending.set(turn.tool, list);
+    } else if (turn.kind === "tool_result") {
+      const command = pending.get(turn.tool)?.shift();
+      if (command) evidence.push(`Command: ${command}\nTool status: ${turn.status}\n${turn.summary}${turn.truncated ? "\n[Stored output was truncated.]" : ""}`);
+    }
+  }
+  if (!evidence.length) return "No retained test/build/lint evidence for the latest request. Tests have not been verified by this review.";
+  return `Recorded verification evidence (not rerun; tool status alone does not prove tests passed):\n\n${evidence.join("\n\n")}`;
+}
+
+interface ReviewDraft {
+  id: string;
+  sessionId: string;
+  revision: string;
+  fingerprint: string;
+  plan: string;
+  createdAt: number;
+  messageId: number | null;
+}
+
+export interface DesktopReviewDeps {
+  api: TelegramApi;
+  ownerUserId: number | null;
+  loadSession(id: string): SessionState | null;
+  currentSession(chatId: number): string | null;
+  isBusy(id: string): boolean;
+  hasQueued(chatId: number): boolean;
+  enqueue(session: SessionState, chatId: number, prompt: string, beforeRun: (fresh: SessionState) => Promise<void>): Promise<boolean>;
+  captureGit?: typeof captureDesktopGitReview;
+  now?: () => number;
+}
+
+/** One-use, owner/chat/message/session-bound review buttons. No file mutations. */
+export class DesktopReviewBridge {
+  private readonly drafts = new Map<number, ReviewDraft>();
+  private readonly requests = new Map<number, object>();
+  private closed = false;
+  constructor(private readonly deps: DesktopReviewDeps) {}
+  close(): void { this.closed = true; this.drafts.clear(); this.requests.clear(); }
+  private now(): number { return this.deps.now?.() ?? Date.now(); }
+  private capture(session: SessionState): Promise<DesktopGitReview> { return (this.deps.captureGit ?? captureDesktopGitReview)(session.workingDir); }
+  private idle(session: SessionState, chatId: number): boolean {
+    return isDesktopSession(session) && this.deps.currentSession(chatId) === session.id && !this.deps.isBusy(session.id) && !this.deps.hasQueued(chatId) && !["running", "awaiting_approval", "awaiting_llm"].includes(session.status);
+  }
+  private async text(chatId: number, text: string): Promise<boolean> {
+    const result = await sendOutbound({ api: this.deps.api, chatId, text: safe(text), parseMode: "plain" });
+    return result.dropped === 0;
+  }
+  async show(session: SessionState, chatId: number, includeDiff = false): Promise<void> {
+    if (this.closed) return;
+    this.drafts.delete(chatId);
+    const request = {};
+    this.requests.set(chatId, request);
+    if (!this.idle(session, chatId)) { await this.text(chatId, "Wait for the linked desktop task and its queue to finish, then use /review."); return; }
+    const plan = desktopReviewPlan(session);
+    if (!plan) { await this.text(chatId, "No completed answer to review. Ask the desktop agent to prepare a plan first."); return; }
+    const revision = desktopReviewRevision(session);
+    let git: DesktopGitReview;
+    try { git = await this.capture(session); }
+    catch { await this.text(chatId, "Could not capture a complete Git review. No approval is available. Check that this is a Git worktree without symlinks/submodules and within the review limits."); return; }
+    const fresh = this.deps.loadSession(session.id);
+    if (this.closed || this.requests.get(chatId) !== request) return;
+    if (!fresh || !this.idle(fresh, chatId) || desktopReviewRevision(fresh) !== revision) { await this.text(chatId, "The session changed during review. Use /review again."); return; }
+    const report = `Desktop review — session ${session.id}\n\nProposed plan (latest final answer):\n${plan}\n\nCurrent Git changes (all changes in this repository; not attributed only to this agent):\n${git.summary}\n\n${desktopReviewEvidence(fresh)}${includeDiff ? `\n\n${git.diff}` : "\n\nUse /review diff to include the tracked-file patch."}`;
+    if (report.length > MAX_REPORT) { await this.text(chatId, "The review exceeds 32,000 characters. No approval was created. Narrow the plan or inspect the changes locally."); return; }
+    if (!await this.text(chatId, report) || this.closed || this.requests.get(chatId) !== request) return;
+    const draft: ReviewDraft = { id: randomBytes(12).toString("hex"), sessionId: session.id, revision, fingerprint: git.fingerprint, plan, createdAt: this.now(), messageId: null };
+    // A failed keyboard delivery must leave no usable approval behind.
+    try {
+      const message = await this.deps.api.sendMessage(chatId,
+        "Approve queues implementation of this exact plan. Reject dismisses this review. Existing edits are kept. Expires in 30 minutes. Normal tool permissions still apply.",
+        { reply_markup: { inline_keyboard: [[{ text: "Approve plan", callback_data: `review:${draft.id}:a` }, { text: "Reject plan", callback_data: `review:${draft.id}:r` }]] } });
+      if (typeof message === "object" && message !== null && "message_id" in message && typeof message.message_id === "number" && !this.closed && this.requests.get(chatId) === request) {
+        draft.messageId = message.message_id;
+        this.drafts.set(chatId, draft);
+      }
+    } catch { await this.text(chatId, "Could not send review buttons. No approval was created; use /review to retry."); }
+  }
+  async handleCallback(update: InboundCallbackUpdate): Promise<boolean> {
+    if (!update.data?.startsWith("review:")) return false;
+    const ack = async (text: string): Promise<void> => { try { await this.deps.api.answerCallbackQuery?.(update.id, { text }); } catch { /* No execution depends on the acknowledgement. */ } };
+    if (this.closed || this.deps.ownerUserId === null || update.from?.id !== this.deps.ownerUserId || !update.message) { await ack("Not available"); return true; }
+    const chatId = update.message.chat.id;
+    const draft = this.drafts.get(chatId);
+    const match = /^review:([a-f0-9]{24}):([ar])$/u.exec(update.data);
+    if (!match || !draft || match[1] !== draft.id || update.message.message_id !== draft.messageId) { await ack("Review expired or already resolved"); return true; }
+    // Consume before any await: replayed or simultaneous clicks execute once.
+    this.drafts.delete(chatId);
+    const finish = async (text: string): Promise<void> => {
+      await ack(text);
+      try { await this.deps.api.editMessageText?.(chatId, draft.messageId!, text, { reply_markup: { inline_keyboard: [] } }); } catch { /* Token is consumed even when the old keyboard cannot be edited. */ }
+      await this.text(chatId, text);
+    };
+    if (this.now() - draft.createdAt >= TTL_MS) { await finish("Review expired. Use /review again."); return true; }
+    if (match[2] === "r") { await finish("Plan rejected. No implementation was queued. Existing edits are kept."); return true; }
+    await ack("Checking review freshness…");
+    const session = this.deps.loadSession(draft.sessionId);
+    if (!session || !this.idle(session, chatId) || desktopReviewRevision(session) !== draft.revision) { await finish("The session changed. Use /review again before approving."); return true; }
+    const validate = async (fresh: SessionState): Promise<void> => {
+      if (this.closed || this.deps.currentSession(chatId) !== draft.sessionId || !isDesktopSession(fresh) || desktopReviewRevision(fresh) !== draft.revision || this.now() - draft.createdAt >= TTL_MS || (await this.capture(fresh)).fingerprint !== draft.fingerprint) {
+        throw new Error("The approved review is stale. Nothing was implemented; use /review again.");
+      }
+    };
+    try {
+      await validate(session);
+      const accepted = await this.deps.enqueue(session, chatId,
+        `The owner approved the following reviewed plan. Implement only this plan, run the relevant checks, and report changes and actual test results in English. Ask before making material changes to the approved scope. Normal tool permissions still apply.\n\n<approved-plan>\n${draft.plan}\n</approved-plan>`, validate);
+      await finish(accepted ? "Plan approved and queued for implementation. Use /status to follow progress or /stop to cancel." : "The request could not be queued. Use /review again.");
+    } catch { await finish("The review changed or could not be verified. Nothing was queued; use /review again."); }
+    return true;
+  }
+}
